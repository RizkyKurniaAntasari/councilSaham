# ---- Opsional: AI Council (sintesis naratif oleh Claude) ----
# Tanpa key ini aplikasi tetap jalan penuh memakai council berbasis rule engine.
ANTHROPIC_API_KEY=
# Model yang dipakai council (default: claude-opus-5)
COUNCIL_MODEL=claude-opus-5

# ---- Opsional: sumber berita tambahan ----
# NewsAPI.org (gratis 100 req/hari) - dipakai sebagai pelengkap Google News RSS
NEWSAPI_KEY=

# ---- Tuning ----
# TTL cache in-memory (detik)
CACHE_TTL=300
